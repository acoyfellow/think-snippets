{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "types": ["@cloudflare/workers-types", "bun-types"],
    "experimentalDecorators": true,
    "lib": ["ES2022"]
  },
  "include": ["src/**/*.ts", "scripts/**/*.ts", "alchemy.run.ts"]
}
