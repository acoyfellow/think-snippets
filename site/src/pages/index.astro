---
// V4 — Editorial proof. Base: Field Notes layout.
// Spliced in:
//   • V3 receipt block, recolored to fit the editorial palette
//   • V1-style ambient corner motion (single restrained SVG attractor)
// Constraint palette: white / black / grays + orange(s) + ONE blue.
const contracts = [
  ['rpc-chat-memory','Memory','Two requests, one Durable Object — fact remembered.','TWO REQUESTS → SAME DO → "OCTARINE"'],
  ['workspace-write-read-proof','Evidence','Model writes; we read the bytes back.','MODEL WROTE BYTES · WE READ BYTES'],
  ['workspace-search-proof','Retrieval','Search/read fires before the answer.','SEARCH FIRED · READ FIRED · ANSWER CITED'],
  ['server-tool-audit-loop','Provenance','Runtime-only output, captured & served.','SQLITE ROW = ASSISTANT ANSWER'],
  ['tool-approval-headless','Approval','Exactly-once, denied otherwise.','DENY → DENY → APPROVE → REPLAY = DENY'],
  ['hook-order-receipt','Lifecycle','Stable partial order, durably proved.','BEFORE · STEP · TOOL · AFTER · RESPONSE'],
  ['clientless-subagent-rpc','Sub-agent','Parent streams a child Think turn.','PARENT.STREAMS(CHILD.TURN)'],
  ['cross-agent-handoff-envelope','Handoff','Typed checksum envelope between agents.','TYPED · CHECKSUMMED · TRANSFERRED'],
  ['scheduled-synthetic-turn','Schedule','Alarm injects a turn, model replies durably.','ALARM → USER MSG → MODEL REPLY'],
  ['execute-tool-state-edit','Sandbox','Sandbox JS mutates workspace state.','GUEST JS WROTE FILE · PARENT READ FILE'],
  ['concurrency-latest-vs-queue','Concurrency','Queue keeps all; latest supersedes middle.','MIDDLE TURN: SUPERSEDED'],
  ['multi-tab-broadcast-protocol','Broadcast','Two sockets, one stream.','TWO SOCKETS · ONE STREAM'],
  ['stream-resume-contract','Resume','Disconnect, replay, agree with transcript.','DISCONNECT → REPLAY → AGREES'],
  ['cli-http-ground-truth','CLI ground truth (HTTP)','Agent runs a real cf CLI over HTTP; the live account is the only source of truth.','PROBE READS CF API · AGENT MUST AGREE'],
  ['cli-sandbox-ground-truth','CLI ground truth (sandbox)','Same real cf CLI, run inside a codemode sandbox; token stays server-side.','SANDBOX RAN CF · STDOUT = LIVE ACCOUNT'],
] as const;
const n = contracts.length;
const repo = 'https://github.com/acoyfellow/think-snippets';
const runSuite = `${repo}#run-everything`;
const deployRpc = 'https://deploy.workers.cloudflare.com/?url=https://github.com/acoyfellow/think-snippets/tree/main/examples/rpc-chat-memory';
const receiptNo = Math.floor(Date.now() / 1000) % 100000;
---
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="canonical" href="https://think.coey.dev/" />
    <title>Think agents, each with a live test</title>
    <meta name="description" content={`${n} small Cloudflare Project Think agents. Each one deploys to a real Worker, runs a live test that proves what it claims, and tears itself down.`} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content="https://think.coey.dev/" />
    <meta property="og:title" content="Small Think agents, each with a live test" />
    <meta property="og:description" content={`${n} small Cloudflare Project Think agents, each with a live test.`} />
    <meta property="og:image" content="https://think.coey.dev/og/index.png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content="https://think.coey.dev/og/index.png" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,400;9..144,500;9..144,700&family=Sohne:wght@400;500;700&family=JetBrains+Mono:wght@500;600&family=Departure+Mono&display=swap" rel="stylesheet" />
    <style>
      :root{--paper:#f5f3ef;--paper-2:#ecead4 ;--paper-3:#fffbf2;--ink:#0f0f0f;--ink-soft:#3b3b3b;--muted:#7d7d7d;--rule:#d4d2cd;--orange:#f25b1c;--orange-soft:#fbd7c2;--blue:#1c4cff}
      *{box-sizing:border-box;margin:0;padding:0}
      html,body{background:var(--paper);color:var(--ink);font-family:"Fraunces",ui-serif,Georgia,serif;font-feature-settings:"ss01","ss02";font-optical-sizing:auto}
      a{color:inherit}
      .mono{font-family:"Departure Mono","JetBrains Mono",ui-monospace,SFMono-Regular,monospace;letter-spacing:.04em;text-transform:uppercase;font-size:.74rem;color:var(--ink-soft)}
      .grotesk{font-family:"Sohne",ui-sans-serif,system-ui,-apple-system,Helvetica,Arial,sans-serif;letter-spacing:-.01em}
      header{padding:24px 32px;display:flex;align-items:baseline;justify-content:space-between;border-bottom:1px solid var(--ink)}
      header .brand{font-size:1.5rem;font-weight:700;letter-spacing:-.04em}
      header .brand b{color:var(--orange)}
      header nav{display:flex;gap:24px;font-family:"Departure Mono","JetBrains Mono",monospace;text-transform:uppercase;font-size:.78rem;letter-spacing:.12em}
      header nav a{text-decoration:none;border-bottom:1px solid transparent;padding-bottom:2px}
      header nav a:hover{border-color:var(--orange);color:var(--orange)}
      .masthead{padding:16px 32px;display:flex;justify-content:space-between;align-items:center;border-bottom:1px solid var(--ink);font-family:"Departure Mono","JetBrains Mono",monospace;text-transform:uppercase;font-size:.74rem;letter-spacing:.08em;color:var(--ink-soft);gap:24px;flex-wrap:wrap}
      .masthead .live{display:inline-flex;align-items:center;gap:8px;color:var(--blue)}
      .masthead .live::before{content:'';width:7px;height:7px;border-radius:50%;background:var(--blue);box-shadow:0 0 0 0 rgba(28,76,255,.4);animation:pulse 2.4s ease-in-out infinite}
      main{max-width:1180px;margin:0 auto;padding:0 32px 80px}
      .hero{padding:54px 0 32px;position:relative}
      .hero .corner{position:absolute;top:24px;right:0;width:180px;height:180px;opacity:.85;pointer-events:none}
      .hero .corner circle{transform-box:fill-box;transform-origin:center}
      .hero .corner .ring{fill:none;stroke:#1d1d1d;stroke-width:.5;opacity:.7}
      .hero .corner .dot{animation:breath 6s ease-in-out infinite}
      .hero .corner .dot:nth-child(2){animation-delay:-1.2s}
      .hero .corner .dot:nth-child(3){animation-delay:-2.4s}
      .hero .corner .dot:nth-child(4){animation-delay:-3.6s}
      .hero .corner .dot:nth-child(5){animation-delay:-4.8s}
      .hero .corner .spine{stroke:var(--orange);stroke-width:.6;stroke-dasharray:3 4;animation:flux 14s linear infinite}
      .label{display:inline-block;border:1px solid var(--ink);padding:4px 10px;font-size:.7rem;letter-spacing:.18em;text-transform:uppercase;font-family:"Departure Mono","JetBrains Mono",monospace;margin-bottom:18px;background:var(--paper-3)}
      h1{font-size:clamp(3.6rem,9.5vw,8.6rem);line-height:.9;letter-spacing:-.055em;font-weight:500;font-style:italic;margin-bottom:28px;max-width:13ch;position:relative}
      h1 .orange{color:var(--orange);font-style:normal}
      h1 .ko{background:var(--ink);color:var(--paper);padding:0 .12em;font-style:normal}
      .standfirst{font-size:clamp(1.18rem,1.9vw,1.5rem);line-height:1.45;color:var(--ink-soft);max-width:780px;font-weight:400}
      .standfirst b{color:var(--ink);font-weight:600}
      .byline{margin-top:30px;display:flex;align-items:center;gap:14px;font-family:"Sohne",ui-sans-serif,system-ui;font-size:.86rem;letter-spacing:.04em;color:var(--ink-soft)}
      .byline strong{font-weight:700;color:var(--ink)}
      .cta-row{display:flex;gap:14px;flex-wrap:wrap;margin-top:28px}
      .btn{font-family:"Sohne",ui-sans-serif,system-ui;font-weight:700;font-size:.94rem;text-transform:uppercase;letter-spacing:.12em;padding:14px 22px;border:1.5px solid var(--ink);background:var(--ink);color:var(--paper);text-decoration:none;transition:transform .12s ease,background .12s ease,color .12s ease,border-color .12s ease;display:inline-flex;align-items:center;gap:12px}
      .btn::before{content:'';display:inline-block;width:8px;height:8px;background:var(--orange);border-radius:50%;box-shadow:0 0 0 0 rgba(242,91,28,.5);animation:pulse 2.1s ease-in-out infinite}
      .btn:hover{transform:translate(-1px,-1px);background:var(--orange);border-color:var(--orange)}
      .btn:hover::before{background:var(--paper);box-shadow:none}
      .btn.alt{background:transparent;color:var(--ink)}
      .btn.alt::before{background:var(--ink)}
      .btn.alt:hover{background:transparent;color:var(--orange);border-color:var(--orange)}
      .btn.alt:hover::before{background:var(--orange)}
      .lockup{display:grid;grid-template-columns:1.4fr 1fr;gap:48px;align-items:end;margin-top:72px;padding-top:32px;border-top:6px double var(--ink)}
      .pull{font-family:"Fraunces",serif;font-style:italic;font-size:clamp(1.4rem,2.2vw,1.95rem);line-height:1.3;color:var(--blue);border-left:3px solid var(--blue);padding-left:18px}
      .meta{font-family:"Sohne",ui-sans-serif,system-ui;font-size:.92rem;color:var(--ink-soft);line-height:1.6}
      .meta b{display:block;font-family:"Departure Mono","JetBrains Mono",monospace;letter-spacing:.12em;text-transform:uppercase;font-size:.7rem;color:var(--ink);margin-bottom:6px}
      .receipt{margin:72px auto 0;max-width:880px;background:var(--paper-3);color:var(--ink);border:1px solid var(--ink);border-radius:6px;padding:32px 32px 44px;position:relative;box-shadow:0 28px 70px rgba(0,0,0,.16);transform:rotate(-.6deg)}
      .receipt::after{content:'';position:absolute;left:0;right:0;bottom:-18px;height:20px;background:linear-gradient(135deg,transparent 25%,var(--paper-3) 25% 75%,transparent 75%);background-size:20px 20px}
      .receipt-top{display:flex;justify-content:space-between;align-items:baseline;border-bottom:2px dashed var(--ink);padding-bottom:14px;margin-bottom:18px;flex-wrap:wrap;gap:18px}
      .receipt-top h2{font-family:"Fraunces",serif;font-style:italic;font-size:1.6rem;letter-spacing:-.02em;font-weight:500}
      .receipt-top span{font-family:"Departure Mono","JetBrains Mono",monospace;letter-spacing:.16em;text-transform:uppercase;font-size:.78rem;color:var(--ink-soft)}
      .receipt ol{list-style:none;font-family:"Departure Mono","JetBrains Mono",monospace;font-size:.92rem}
      .receipt li{display:flex;justify-content:space-between;gap:18px;padding:10px 0;border-bottom:1px dashed rgba(15,15,15,.22);letter-spacing:.04em;flex-wrap:wrap}
      .receipt li b{font-weight:700;color:var(--orange);text-transform:uppercase}
      .receipt li i{font-style:normal;color:var(--ink-soft);text-align:right}
      .receipt small{display:block;margin-top:20px;font-family:"Departure Mono","JetBrains Mono",monospace;font-size:.74rem;text-align:center;text-transform:uppercase;letter-spacing:.24em;color:var(--ink-soft)}
      .ledger{margin-top:72px;border:1px solid var(--ink);background:#fff}
      .ledger-row{display:grid;grid-template-columns:54px 1fr 240px 110px;gap:18px;align-items:baseline;padding:14px 22px;border-bottom:1px solid var(--rule);font-family:"Sohne",ui-sans-serif,system-ui;font-size:1rem;transition:background .12s ease}
      .ledger-row:last-child{border-bottom:0}
      .ledger-row:hover{background:#fdf2eb}
      .ledger-row .num{font-family:"Departure Mono","JetBrains Mono",monospace;color:var(--orange);font-weight:700;letter-spacing:.1em}
      .ledger-row h3{font-family:"Fraunces",serif;font-size:1.32rem;letter-spacing:-.02em;font-weight:500;font-style:italic}
      .ledger-row p{color:var(--ink-soft);line-height:1.4;font-size:.96rem}
      .ledger-row a{font-family:"Departure Mono","JetBrains Mono",monospace;font-size:.78rem;letter-spacing:.12em;text-transform:uppercase;justify-self:end;text-decoration:none;border-bottom:1px solid var(--ink);padding-bottom:2px}
      .ledger-row a:hover{color:var(--orange);border-color:var(--orange)}
      .cta{margin-top:60px;display:flex;justify-content:space-between;align-items:flex-end;gap:24px;flex-wrap:wrap}
      .cta-block{max-width:520px}
      .cta-block h2{font-family:"Fraunces",serif;font-size:clamp(1.8rem,3vw,2.4rem);font-style:italic;letter-spacing:-.02em;line-height:1.04}
      footer{margin-top:80px;padding:24px 32px;border-top:1px solid var(--ink);font-family:"Departure Mono","JetBrains Mono",monospace;letter-spacing:.1em;text-transform:uppercase;color:var(--ink-soft);font-size:.74rem;display:flex;justify-content:space-between;gap:18px;flex-wrap:wrap}
      @keyframes pulse{0%,100%{box-shadow:0 0 0 0 rgba(242,91,28,.5)}50%{box-shadow:0 0 0 10px rgba(242,91,28,0)}}
      @keyframes breath{0%,100%{transform:scale(.6);opacity:.4}50%{transform:scale(1.2);opacity:1}}
      @keyframes flux{to{stroke-dashoffset:-220}}
      /* keep everything inside the viewport on every width */
      html,body{overflow-x:hidden}
      img,svg{max-width:100%}

      /* tablet / small laptop */
      @media (max-width:1000px){
        main{padding:0 24px 64px}
        .ledger-row{grid-template-columns:46px 1fr 150px;gap:14px}
        .ledger-row a{grid-column:1 / -1;justify-self:start;margin-top:2px}
        .lockup{gap:32px}
        .hero{padding:44px 0 28px}
      }

      /* phone */
      @media (max-width:760px){
        header,.masthead,footer{padding-left:20px;padding-right:20px}
        header nav{gap:16px}
        main{padding:0 20px 56px}
        .hero{padding:32px 0 24px}
        h1{font-size:clamp(2.6rem,13vw,4.4rem);margin-bottom:22px;max-width:100%}
        .lockup{grid-template-columns:1fr;gap:24px;margin-top:48px}
        .receipt{margin-top:48px;padding:24px 18px 36px;transform:none;box-shadow:0 14px 40px rgba(0,0,0,.14)}
        .receipt-top h2{font-size:1.2rem;word-break:break-word}
        .ledger{margin-top:48px}
        .ledger-row{grid-template-columns:32px 1fr;gap:6px 10px;padding:14px 16px}
        .ledger-row p,.ledger-row p.mono,.ledger-row a{grid-column:1 / -1}
        .ledger-row p.mono{color:var(--muted);margin-top:2px}
        .cta{margin-top:48px}
        .cta-row{width:100%}
        .btn{flex:1 1 auto;justify-content:center}
        .hero .corner{display:none}
      }

      /* small phone */
      @media (max-width:430px){
        header{flex-wrap:wrap;gap:8px}
        .masthead{font-size:.66rem;gap:10px}
        h1{font-size:clamp(2.1rem,12vw,3.2rem)}
        .standfirst{font-size:1.05rem}
        .receipt li{font-size:.8rem}
        .btn{font-size:.82rem;padding:13px 14px;letter-spacing:.08em}
      }
      @media (prefers-reduced-motion: reduce){*{animation:none!important}}
    </style>
  </head>
  <body>
    <header>
      <div class="brand">think<b>.</b></div>
      <nav><a href={repo}>Source</a><a href={deployRpc}>Deploy</a></nav>
    </header>
    <div class="masthead">
      <span>@cloudflare/think</span>
      <span>github.com/acoyfellow/think-snippets</span>
      <span class="live">{n} examples · live</span>
    </div>
    <main>
      <section class="hero">
        <svg class="corner" viewBox="-100 -100 200 200" preserveAspectRatio="xMidYMid meet" aria-hidden="true">
          <circle class="ring" r="78" />
          <circle class="ring" r="55" />
          <circle class="ring" r="32" />
          <line class="spine" x1="0" y1="-100" x2="0" y2="100" />
          <circle class="dot" cx="0" cy="-78" r="3" fill="#0f0f0f" />
          <circle class="dot" cx="74" cy="-26" r="3" fill="#0f0f0f" />
          <circle class="dot" cx="46" cy="63" r="3" fill="#0f0f0f" />
          <circle class="dot" cx="-46" cy="63" r="3" fill="#0f0f0f" />
          <circle class="dot" cx="-74" cy="-26" r="3" fill="#0f0f0f" />
          <circle cx="0" cy="0" r="6" fill="#f25b1c" />
        </svg>
        <span class="label">{n} examples</span>
        <h1>Small Think agents, each with a <span class="orange">live</span> <span class="ko">test.</span></h1>
        <p class="standfirst"><b>Project Think</b> is Cloudflare's agent runtime. This is a collection of {n} small examples. Each one deploys to a real Worker, runs a test that proves what it claims, and tears itself down afterward.</p>
        <div class="byline">
          <span>By</span><strong>think.coey.dev</strong><span>·</span><span>Updated 2026.06</span>
        </div>
        <div class="cta-row">
          <a class="btn" href={deployRpc}>Deploy rpc-chat-memory</a>
          <a class="btn alt" href={runSuite}>Run the full suite</a>
        </div>
      </section>
      <section class="lockup">
        <p class="pull">Each example makes one claim and ships a test for it. If the test doesn't pass live, it doesn't go in.</p>
        <div class="meta">
          <b>About this issue</b>
          Each contract is isolated: its own Worker, its own Durable Object bindings, its own probe, its own teardown. We do not stage screenshots; we read durable state. Personal Cloudflare deploys only.
        </div>
      </section>
      <section class="receipt" aria-label="receipt">
        <div class="receipt-top">
          <h2>think.coey.dev / receipt #{receiptNo}</h2>
          <span>{n}/{n} · live</span>
        </div>
        <ol>{contracts.map(([slug,label,_,proof], i) => <li><span><b>{String(i+1).padStart(2,'0')}</b> · {label}</span><i>{proof}</i></li>)}</ol>
        <small>**** end of transmission ****</small>
      </section>
      <section class="ledger" aria-label="ledger">
        {contracts.map(([slug,title,blurb], i) => (
          <div class="ledger-row">
            <span class="num">{String(i+1).padStart(2,'0')}</span>
            <div>
              <h3>{title}</h3>
              <p>{blurb}</p>
            </div>
            <p class="mono">{slug}</p>
            <a href={`${repo}/tree/main/examples/${slug}`}>Read →</a>
          </div>
        ))}
      </section>
      <section class="cta">
        <div class="cta-block">
          <span class="label">Try it</span>
          <h2>Deploy one, or run the whole set against your own account.</h2>
        </div>
        <div class="cta-row">
          <a class="btn" href={deployRpc}>Deploy rpc-chat-memory</a>
          <a class="btn alt" href={runSuite}>Run the full suite</a>
        </div>
      </section>
    </main>
    <footer>
      <span>© think.coey.dev</span>
      <span>Set in Fraunces · Sohne · Departure Mono</span>
    </footer>
  </body>
</html>
