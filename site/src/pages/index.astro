---
import '../styles/global.css';

const examples = [
  ['rpc-chat-memory','RPC chat memory','HTTP → Think.chat() streamed RPC, then a second request proves DO memory persisted.',['RPC','Durable Objects']],
  ['workspace-write-read-proof','Workspace write proof','A model calls write; a separate DO RPC reads real SQLite-backed workspace bytes.',['workspace','storage evidence']],
  ['workspace-search-proof','Workspace search proof','Seed six files; the durable tool log must show search/read before the hidden fact answer.',['workspace','tool audit']],
  ['server-tool-audit-loop','Server tool audit loop','Runtime-only tool output appears both in a SQLite audit row and the assistant answer.',['tools','provenance']],
  ['tool-approval-headless','Headless approval gate','Denied, missing-ticket, approved, and replay branches prove server-enforced exactly-once behavior.',['tools','negative cases']],
  ['hook-order-receipt','Hook order receipt','A durable receipt proves Think’s stable lifecycle partial order, not an anecdotal log.',['hooks','SQLite receipt']],
  ['clientless-subagent-rpc','Clientless child agent RPC','A parent agent streams a child Think turn; child sessions persist and remain isolated.',['sub-agents','RPC']],
  ['cross-agent-handoff-envelope','Cross-agent handoff envelope','Producer and consumer share a typed checksum envelope, not loose LLM prose.',['handoff','schema']],
  ['scheduled-synthetic-turn','Scheduled synthetic turn','An immediate schedule alarm injects a synthetic user message and persists the answer.',['schedule','server driven']],
  ['execute-tool-state-edit','Execute tool state edit','Sandboxed JavaScript edits workspace state; the parent Think DO reads it directly.',['execute','sandbox']],
  ['concurrency-latest-vs-queue','Latest vs queue concurrency','Wire receipts show queue keeps all turns while latest supersedes the middle overlap.',['concurrency','websocket']],
  ['multi-tab-broadcast-protocol','Multi-tab broadcast protocol','Two headless sockets attached to one chat both receive the same streamed request id.',['protocol','broadcast']],
  ['stream-resume-contract','Stream resume contract','Disconnect, reconnect, replay chunks, then compare with the persisted assistant transcript.',['protocol','resume']],
] as const;
const repo = 'https://github.com/acoyfellow/think-snippets';
const deploy = 'https://deploy.workers.cloudflare.com/?url=https://github.com/acoyfellow/think-snippets';
---
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="canonical" href="https://think.coey.dev/" />
    <title>Think contracts that actually run</title>
    <meta name="description" content="Fourteen small, live-proven Cloudflare Project Think contracts. Every example deploys to Workers, asserts real evidence, and destroys itself." />
    <meta property="og:type" content="website" />
    <meta property="og:url" content="https://think.coey.dev/" />
    <meta property="og:title" content="Think contracts that actually run" />
    <meta property="og:description" content="Not another assistant demo: 14 deployable Cloudflare Think contracts with real E2E evidence." />
    <meta property="og:image" content="https://think.coey.dev/og/index.png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Think contracts that actually run. 14 deployable Cloudflare Project Think examples." />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content="Think contracts that actually run" />
    <meta name="twitter:description" content="Not another assistant demo: 14 deployable Cloudflare Think contracts with real E2E evidence." />
    <meta name="twitter:image" content="https://think.coey.dev/og/index.png" />
    <meta name="twitter:image:alt" content="Think contracts that actually run. 14 deployable Cloudflare Project Think examples." />
  </head>
  <body>
    <main class="shell">
      <nav class="nav">
        <a class="brand" href="/">think.coey.dev</a>
        <div class="links"><a href="#examples">examples</a><a href="#why">why</a><a href={repo}>GitHub</a><a href={deploy}>Deploy</a></div>
      </nav>
      <section class="hero">
        <div>
          <div class="eyebrow">Cloudflare Project Think · verified contracts</div>
          <h1>Not another assistant demo.</h1>
          <p class="lede">This is the sharp edge map for <code>@cloudflare/think</code>: RPC startup, tool provenance, workspace evidence, typed handoffs, concurrency, websocket broadcast, and stream replay. Each example is isolated, deployable, live-probed, and cleaned up.</p>
          <div class="cta"><a class="button" href={repo}>Read the repo →</a><a class="button alt" href={deploy}>Deploy to Cloudflare</a></div>
        </div>
        <aside class="proof"><span class="eyebrow">repo contract</span><strong>14</strong><p>non-overlapping examples selected after mapping official and public Think demos.</p><ul><li>one Worker per example</li><li>personal-CF guarded live E2E</li><li>probe output beats screenshots</li></ul></aside>
      </section>
      <section class="strip">
        <div class="stat"><b>14</b><span>Deploy buttons</span></div><div class="stat"><b>DO</b><span>SQLite-backed evidence</span></div><div class="stat"><b>E2E</b><span>deploy → prove → destroy</span></div><div class="stat"><b>0</b><span>generic chat starters</span></div>
      </section>
      <section id="why" class="section panels">
        <div class="panel"><h2>Why this exists</h2><p class="lede">Cloudflare already ships a flagship assistant, a durable submission dashboard, and agent-tools demos. This site deliberately fills the gaps they leave: small falsifiable contracts, especially where a Builder's intuition fails.</p></div>
        <div class="panel"><h2>Run the suite</h2><pre><code>git clone {repo}
cd think-snippets
bun install
export CLOUDFLARE_PERSONAL_ACCOUNT_ID=...
export CLOUDFLARE_PERSONAL_API_TOKEN=...
bun run e2e:examples</code></pre></div>
      </section>
      <section id="examples" class="section">
        <div class="eyebrow">the catalog</div><h2>Every card is a claim with a probe.</h2>
        <div class="grid">{examples.map(([slug,title,copy,pills]) => <article class="card"><div class="pillrow">{pills.map((pill) => <span class="pill">{pill}</span>)}</div><h3>{title}</h3><p>{copy}</p><div class="cardlinks"><a href={`${repo}/tree/main/examples/${slug}`}>source →</a><a href={deploy}>deploy →</a></div></article>)}</div>
      </section>
      <footer class="footer">Built to make Cloudflare Think behavior inspectable. Source, probes, and deploy buttons live in <a href={repo}>acoyfellow/think-snippets</a>.</footer>
    </main>
  </body>
</html>
